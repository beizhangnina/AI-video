# Token360 API credentials
TOKEN360_API_KEY=sk-your-token360-api-key-here
TOKEN360_BASE_URL=https://api.token360.ai/v1

# Default models (override per-call in scripts if you want)
AIVIDEO_LLM_MODEL=gpt-4o
AIVIDEO_IMAGE_MODEL=dall-e-3
AIVIDEO_TTS_MODEL=tts-1-hd
AIVIDEO_TTS_VOICE=alloy
AIVIDEO_VIDEO_MODEL=seedance-2.0-fast

# Default video output spec (vertical short)
AIVIDEO_WIDTH=1080
AIVIDEO_HEIGHT=1920
AIVIDEO_FPS=30
