# Token360 API credentials
TOKEN360_API_KEY=sk-your-token360-api-key-here
TOKEN360_BASE_URL=https://api.token360.ai/v1

# Default models (override per-call in scripts if you want).
# Below are the slugs verified to work on Token360 as of 2026-05.
# If your account exposes different model IDs, edit these.
AIVIDEO_LLM_MODEL=glm-5.1
AIVIDEO_IMAGE_MODEL=nano-banana-pro
AIVIDEO_TTS_MODEL=tts-1-hd
AIVIDEO_TTS_VOICE=alloy
AIVIDEO_VIDEO_MODEL=seedance-2.0

# Default video output spec (vertical short)
AIVIDEO_WIDTH=1080
AIVIDEO_HEIGHT=1920
AIVIDEO_FPS=30
